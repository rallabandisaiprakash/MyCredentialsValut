<Window x:Class="MyCredentialsValut.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Vault"
        Icon="Assets/MyValutLogo.ico"
        Height="550"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="15"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="5"
                Padding="15">

            <StackPanel>

                <TextBlock Text="Entity Name"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtEntity"
                         Height="30"/>

                <TextBlock Text="User Name"
                           Margin="0,15,0,5"/>

                <TextBox x:Name="txtUserName"
                         Height="30"/>

                <TextBlock Text="Password"
                           Margin="0,15,0,5"/>

                <TextBox x:Name="txtPassword"
                         Height="30"/>

                <Button x:Name="btnSave"
                        Content="Save"
                        Height="35"
                        Margin="0,20,0,0"
                        Click="Save_Click"/>

            </StackPanel>

        </Border>

        <!-- RIGHT PANEL -->
        <Border Grid.Column="2"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SEARCH -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,10">

                    <TextBlock Text="Search:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBox x:Name="txtSearch"
                             Width="250"
                             Height="30"
                             TextChanged="txtSearch_TextChanged"/>

                </StackPanel>

                <!-- DATAGRID -->
                <DataGrid x:Name="dgCredentials"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Margin="0,0,0,10">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Entity"
                                            Binding="{Binding EntityName}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="User Name"
                                            Binding="{Binding UserName}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="Password"
                                            Binding="{Binding MaskedPassword}"
                                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- BUTTONS -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button Content="View Password"
                            Width="120"
                            Margin="5"
                            Click="ViewPassword_Click"/>

                    <Button Content="Copy Password"
                            Width="120"
                            Margin="5"
                            Click="CopyPassword_Click"/>

                    <Button Content="Edit"
                            Width="100"
                            Margin="5"
                            Click="Edit_Click"/>

                    <Button Content="Delete"
                            Width="100"
                            Margin="5"
                            Click="Delete_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>